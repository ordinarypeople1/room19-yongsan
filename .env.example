# Copy to .env locally. Never put a real key in browser code or commit it.
OPENROUTER_API_KEY=
# Set the exact model ID chosen in OpenRouter. No paid default is selected.
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
# prompt works without requiring JSON-mode support; optionally use json.
OPENROUTER_RESPONSE_FORMAT=prompt
